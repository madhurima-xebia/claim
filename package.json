{
  "name": "claim-system",
  "version": "1.0.0",
  "description": "Claim initiation module for insurance claims",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "server": "ts-node src/api/server.ts",
    "server:build": "npm run build && node dist/api/server.js",
    "ui:build": "webpack --config webpack.config.js --mode production",
    "ui:dev": "webpack serve --config webpack.config.js --mode development",
    "test": "jest"
  },
  "keywords": [
    "claim",
    "insurance"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/swagger-ui-express": "^4.1.0",
    "@types/uuid": "^10.0.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.0.0",
    "style-loader": "^3.3.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
